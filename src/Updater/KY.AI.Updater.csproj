<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KY.AI.Updater</RootNamespace>
    <AssemblyName>ky-ai-updater</AssemblyName>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Packed and published as a .NET global tool: dotnet tool install KY.AI.Updater.
         Portable (no RuntimeIdentifier) so the tool shim runs wherever the .NET 10 runtime
         is installed. Deliberately stand-alone: it references nothing (not even Serve) so the
         one tool whose job is to replace the others carries no shared, lockable dependencies. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ky-ai-updater</ToolCommandName>
    <PackageId>KY.AI.Updater</PackageId>
    <Authors>KY-Programming</Authors>
    <Company>KY-Programming</Company>
    <Product>KY.AI</Product>
    <Copyright>2026 - KY-Programming</Copyright>
    <Description>One command to update the whole KY.AI tool suite: updates itself first, then every other installed ky-ai-* tool.</Description>
    <PackageTags>dotnet;mcp;ai;cli;updater</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/KY-Programming/AI</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/KY-Programming/AI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Ship this README as the package readme (rendered on nuget.org). Use Update,
       not Include: the SDK already globs README.md as a None item. -->
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
