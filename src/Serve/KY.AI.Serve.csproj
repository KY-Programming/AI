<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KY.AI.Serve</RootNamespace>
    <Version>1.3.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Published as a NuGet library (the shared hub / supervisor / MCP engine).
         It also ships bundled inside the Ng and Net tool packages. -->
    <PackageId>KY.AI.Serve</PackageId>
    <Authors>KY-Programming</Authors>
    <Company>KY-Programming</Company>
    <Product>KY.AI</Product>
    <Copyright>2026 - KY-Programming</Copyright>
    <Description>Shared hub, supervisor and MCP engine behind the KY.AI dev-loop tools.</Description>
    <PackageTags>mcp;ai;dev-server</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/KY-Programming/AI</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/KY-Programming/AI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Ship this README as the package readme (rendered on nuget.org). Use Update,
       not Include: the SDK already globs README.md as a None item. -->
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>
  <!-- Plain Microsoft.NET.Sdk doesn't add the ASP.NET Core implicit usings the Web SDK gives;
       add them so the shared hosting code reads the same as it did inside each exe. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
